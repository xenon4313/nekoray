diff --git a/option/inbound_legacy_test.go b/option/inbound_legacy_test.go
new file mode 100644
index 00000000..1529ad38
--- /dev/null
+++ b/option/inbound_legacy_test.go
@@ -0,0 +1,118 @@
+package option
+
+import (
+	"context"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing/common/json"
+	"github.com/sagernet/sing/service"
+
+	"github.com/stretchr/testify/require"
+)
+
+type stubInboundOptionsRegistry struct{}
+
+func (stubInboundOptionsRegistry) OptionTypes() []string {
+	return []string{C.TypeMixed, C.TypeTun}
+}
+
+func (stubInboundOptionsRegistry) CreateOptions(inboundType string) (any, bool) {
+	switch inboundType {
+	case C.TypeMixed:
+		return new(HTTPMixedInboundOptions), true
+	case C.TypeTun:
+		return new(TunInboundOptions), true
+	default:
+		return nil, false
+	}
+}
+
+func TestLegacyInboundUpgradeMixedAndTun(t *testing.T) {
+	t.Parallel()
+
+	ctx := service.ContextWith[InboundOptionsRegistry](context.Background(), stubInboundOptionsRegistry{})
+	rawConfig := []byte(`{
+		"inbounds": [
+			{
+				"tag": "mixed-in",
+				"type": "mixed",
+				"listen": "127.0.0.1",
+				"listen_port": 2080,
+				"sniff": true,
+				"sniff_override_destination": true,
+				"domain_strategy": "prefer_ipv4"
+			},
+			{
+				"tag": "tun-in",
+				"type": "tun",
+				"interface_name": "neko-tun",
+				"sniff": true,
+				"domain_strategy": "prefer_ipv6"
+			}
+		],
+		"route": {
+			"rules": [
+				{
+					"protocol": "dns",
+					"action": "hijack-dns"
+				}
+			]
+		}
+	}`)
+
+	options, err := json.UnmarshalExtendedContext[Options](ctx, rawConfig)
+	require.NoError(t, err)
+
+	require.Len(t, options.Inbounds, 2)
+
+	// Verify route rules:
+	// Should have:
+	// 0: sniff mixed-in (override_destination: true)
+	// 1: resolve mixed-in (strategy: prefer_ipv4)
+	// 2: sniff tun-in
+	// 3: resolve tun-in (strategy: prefer_ipv6)
+	// 4: hijack-dns
+	require.Len(t, options.Route.Rules, 5)
+
+	rule0 := options.Route.Rules[0]
+	require.Equal(t, C.RuleTypeDefault, rule0.Type)
+	require.Equal(t, C.RuleActionTypeSniff, rule0.DefaultOptions.Action)
+	require.Equal(t, []string{"mixed-in"}, []string(rule0.DefaultOptions.Inbound))
+	require.True(t, rule0.DefaultOptions.SniffOptions.OverrideDestination)
+
+	rule1 := options.Route.Rules[1]
+	require.Equal(t, C.RuleTypeDefault, rule1.Type)
+	require.Equal(t, C.RuleActionTypeResolve, rule1.DefaultOptions.Action)
+	require.Equal(t, []string{"mixed-in"}, []string(rule1.DefaultOptions.Inbound))
+	require.Equal(t, DomainStrategy(C.DomainStrategyPreferIPv4), rule1.DefaultOptions.ResolveOptions.Strategy)
+
+	rule2 := options.Route.Rules[2]
+	require.Equal(t, C.RuleTypeDefault, rule2.Type)
+	require.Equal(t, C.RuleActionTypeSniff, rule2.DefaultOptions.Action)
+	require.Equal(t, []string{"tun-in"}, []string(rule2.DefaultOptions.Inbound))
+	require.False(t, rule2.DefaultOptions.SniffOptions.OverrideDestination)
+
+	rule3 := options.Route.Rules[3]
+	require.Equal(t, C.RuleTypeDefault, rule3.Type)
+	require.Equal(t, C.RuleActionTypeResolve, rule3.DefaultOptions.Action)
+	require.Equal(t, []string{"tun-in"}, []string(rule3.DefaultOptions.Inbound))
+	require.Equal(t, DomainStrategy(C.DomainStrategyPreferIPv6), rule3.DefaultOptions.ResolveOptions.Strategy)
+
+	rule4 := options.Route.Rules[4]
+	require.Equal(t, C.RuleActionTypeHijackDNS, rule4.DefaultOptions.Action)
+}
+
+func TestHysteria2GeckoPasswordPrefix(t *testing.T) {
+	t.Parallel()
+
+	raw := []byte(`{"type": "salamander", "password": "gecko:mysecret:1200:1400"}`)
+	var obfs Hysteria2Obfs
+	err := json.Unmarshal(raw, &obfs)
+	require.NoError(t, err)
+
+	require.Equal(t, C.Hysteria2ObfsTypeGecko, obfs.Type)
+	require.Equal(t, "mysecret", obfs.Password)
+	require.Equal(t, 1200, obfs.GeckoOptions.MinPacketSize)
+	require.Equal(t, 1400, obfs.GeckoOptions.MaxPacketSize)
+}
