+
+func upgradeLegacyInbounds(o *Options) {
+	if o == nil || len(o.Inbounds) == 0 {
+		return
+	}
+	var newRules []Rule
+	for i := range o.Inbounds {
+		inbound := &o.Inbounds[i]
+		var inboundOptions InboundOptions
+		if listenWrapper, isListen := inbound.Options.(ListenOptionsWrapper); isListen {
+			listenOpts := listenWrapper.TakeListenOptions()
+			inboundOptions = listenOpts.InboundOptions
+			listenOpts.InboundOptions = InboundOptions{}
+			listenWrapper.ReplaceListenOptions(listenOpts)
+		} else if tunOpts, isTun := inbound.Options.(*TunInboundOptions); isTun {
+			inboundOptions = tunOpts.InboundOptions
+			tunOpts.InboundOptions = InboundOptions{}
+		}
+
+		if inboundOptions.SniffEnabled {
+			hasSniff := false
+			if o.Route != nil {
+				for _, rule := range o.Route.Rules {
+					if rule.Type == C.RuleTypeDefault && rule.DefaultOptions.Action == C.RuleActionTypeSniff {
+						if inbound.Tag == "" || len(rule.DefaultOptions.Inbound) == 0 || slices.Contains(rule.DefaultOptions.Inbound, inbound.Tag) {
+							hasSniff = true
+							break
+						}
+					}
+				}
+			}
+			if !hasSniff {
+				sniffRule := Rule{
+					Type: C.RuleTypeDefault,
+					DefaultOptions: DefaultRule{
+						RuleAction: RuleAction{
+							Action: C.RuleActionTypeSniff,
+							SniffOptions: RouteActionSniff{
+								Timeout:             inboundOptions.SniffTimeout,
+								OverrideDestination: inboundOptions.SniffOverrideDestination,
+							},
+						},
+					},
+				}
+				if inbound.Tag != "" {
+					sniffRule.DefaultOptions.Inbound = badoption.Listable[string]{inbound.Tag}
+				}
+				newRules = append(newRules, sniffRule)
+			}
+		}
+
+		if C.DomainStrategy(inboundOptions.DomainStrategy) != C.DomainStrategyAsIS {
+			hasResolve := false
+			if o.Route != nil {
+				for _, rule := range o.Route.Rules {
+					if rule.Type == C.RuleTypeDefault && rule.DefaultOptions.Action == C.RuleActionTypeResolve {
+						if inbound.Tag == "" || len(rule.DefaultOptions.Inbound) == 0 || slices.Contains(rule.DefaultOptions.Inbound, inbound.Tag) {
+							hasResolve = true
+							break
+						}
+					}
+				}
+			}
+			if !hasResolve {
+				resolveRule := Rule{
+					Type: C.RuleTypeDefault,
+					DefaultOptions: DefaultRule{
+						RuleAction: RuleAction{
+							Action: C.RuleActionTypeResolve,
+							ResolveOptions: RouteActionResolve{
+								Strategy: inboundOptions.DomainStrategy,
+							},
+						},
+					},
+				}
+				if inbound.Tag != "" {
+					resolveRule.DefaultOptions.Inbound = badoption.Listable[string]{inbound.Tag}
+				}
+				newRules = append(newRules, resolveRule)
+			}
+		}
+	}
+
+	if len(newRules) > 0 {
+		if o.Route == nil {
+			o.Route = &RouteOptions{}
+		}
+		o.Route.Rules = append(newRules, o.Route.Rules...)
+	}
+}
